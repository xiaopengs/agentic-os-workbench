# ─────────────────────────────────────────────────────────────
# Agentic OS Workbench · 前端环境变量模板
# 复制为 .env.local 后按需修改（.env.local 不入库）
# ─────────────────────────────────────────────────────────────

# 后端 API 基础路径。方案 A 为同域部署，留空即使用 /api
# 若将来后端拆为独立项目（方案 B），改为 https://<api-host>/api
NEXT_PUBLIC_API_BASE=/api

# ── AI Gateway（服务端变量，平台部署时自动注入） ──────────────
# 由 EdgeOne Makers 平台在部署时自动注入，本地开发留空即可。
# 前端不直连大模型：AI Copilot 走 POST /api/ai/copilot（SSE），
# 由后端（backend/functions/copilot.ts）与平台 Agent（agents/copilot）
# 通过 AI Gateway 调用，凭据只存在于服务端。
#
# ⚠️ 部署单元根目录也有一份 .env.example，内容为本文件的超集
#    （额外声明 JWT_SECRET / WSA_API_KEY），以那份为准。
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=
# 可选：覆盖默认模型（缺省 @makers/deepseek-v4-flash）
AI_GATEWAY_MODEL=