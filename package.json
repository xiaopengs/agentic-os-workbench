{
  "name": "agentic-os-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic OS 自动化开发工作台 · 同仓库逻辑分离（frontend/ + backend/ + shared/）",
  "scripts": {
    "typecheck:backend": "tsc --noEmit -p backend/tsconfig.json",
    "test:api": "tsx tests/api-smoke.ts",
    "test:loop-kernel": "tsx --test tests/loop-kernel.test.ts",
    "test:loop-api": "tsx tests/loop-api-smoke.ts",
    "test:loop": "npm run test:loop-kernel && npm run test:loop-api",
    "test:loop-concurrency": "node tests/loop-concurrency-e2e.mjs",
    "test:loop-approval": "node tests/loop-approval-e2e.mjs",
    "test:loop-m4": "node tests/loop-m4-e2e.mjs",
    "test:decision-kernel": "tsx --test tests/decision-kernel.test.ts",
    "test:decision-api": "tsx tests/decision-api-smoke.ts",
    "test:decision-ui": "node tests/decision-ui-viewports.mjs",
    "test:decision-integration": "node tests/decision-loop-integration.mjs",
    "test:unit-boundaries": "tsx --test tests/unit-boundaries.test.ts",
    "test:platform": "tsx tests/platform-smoke.ts",
    "test:all": "npm run test:api && npm run test:unit-boundaries && npm run test:loop-worker && npm run test:loop-plugins && npm run test:platform && npm run test:loop-kernel && npm run test:loop-api && npm run test:decision-kernel && npm run test:decision-api && npm run typecheck:backend",
    "test:loop-ui": "node tests/loop-ui-viewports.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "build:deploy": "node scripts/build-deploy.mjs",
    "build:app": "node scripts/build-app.mjs",
    "test:loop-worker": "tsx --test tests/loop-worker.test.ts",
  "test:loop-plugins": "tsx --test tests/loop-plugins.test.ts",
    "test:loop-worker-e2e": "node tests/loop-worker-e2e.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "@edgeone/pages-blob": "^0.0.18"
  }
}