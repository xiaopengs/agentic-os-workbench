# ─────────────────────────────────────────────────────────────
# Agentic OS Workbench · 部署单元环境变量声明
#
# ⚠️ 本文件必须提交入库：EdgeOne Makers CLI 依据本文件的声明决定
#    部署时自动注入哪些变量。缺少声明 = 线上拿不到值 = 运行时报错。
#
# 变量分类：
#   ① 平台自动注入（无需手工设置，只要在此声明即可）
#   ② 业务变量（必须手工 `edgeone makers env set <KEY> <VALUE>`）
# ─────────────────────────────────────────────────────────────

# ── ① AI Gateway（平台自动注入，本地开发可留空） ──────────────
# AI Copilot 服务端经 AI Gateway 调用大模型：
#   backend/functions/copilot.ts → POST /api/ai/copilot（SSE）
#   agents/copilot/index.ts      → POST /copilot（平台 Agent 运行时）
# 凭据只存在于服务端，前端不直连大模型。
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=
# 可选：覆盖默认模型（缺省 @makers/deepseek-v4-flash）
AI_GATEWAY_MODEL=

# ── 本地最小化部署（可选，不影响云端） ────────────────────────
# 未配置 AI Gateway 时，设为 1 让 /api/ai/copilot 走本地模拟 SSE 流，
# 便于离线验证流式协议 / 配额扣减 / 审计落库全链路。
# ⚠️ 只作用于 AI Copilot 侧栏；Autoloop 执行器走真实 CLI Agent，不受此开关影响。
LOCAL_AI_MOCK=

# ── M7/M8 真实 Agent 自动执行器（可选，均有默认值） ──────────
# 事件命中规则后，常驻执行器自动领走轮次并调用真实 Agent 执行、回写真回执。
# M8 双层插件：Harness（谁跑）× Provider（模型从哪来），协议是唯一契约。
# 默认 codebuddy × platform，走本机已登录 CLI，无需任何 API Key。
LOOP_WORKER_HARNESS=codebuddy   # codebuddy | claude-code | codex | gemini-cli | http-direct
LOOP_WORKER_PROVIDER=platform   # platform | openrouter | deepseek | kimi | glm | custom
LOOP_WORKER_BASE_URL=           # 覆盖供应商默认端点；留空用注册表默认值
LOOP_WORKER_MODEL=              # 显式模型 ID；留空用注册表 / 平台默认档
LOOP_WORKER_MODE=cli            # 兼容别名：cli | gateway | off（仅 off 有执行语义）
LOOP_WORKER_BIN=codebuddy       # CLI 名称或绝对路径
LOOP_WORKER_INTERVAL_MS=15000   # 自动轮询间隔（毫秒）
LOOP_WORKER_TIMEOUT_MS=120000   # 单轮 Agent 超时（毫秒）
LOOP_WORKER_MAX_PER_TICK=1      # 每轮最多执行几个轮次（1-5）
LOOP_WORKER_AUTO=1             # 0 = 关自动轮询，仅手动触发
LOOP_WORKER_DISABLE=            # 1 = 完全不加载执行器
#
# 各家 API Key 也可放部署环境（优先级：面板填写 > 下列变量 > AI_GATEWAY_API_KEY）：
# OPENROUTER_API_KEY= / DEEPSEEK_API_KEY= / MOONSHOT_API_KEY= / ZHIPU_API_KEY=
# 旧 gateway 配置仍兼容：AI_GATEWAY_API_KEY / AI_GATEWAY_BASE_URL / AI_GATEWAY_MODEL
# 面板「连接设置」可覆盖端点、模型、Key；Key 只提交不回显，独立存服务端 KV。

# ── ② 鉴权（必须手工设置，≥32 位随机串） ─────────────────────
# 未注入时：生产环境所有鉴权接口返回 500 SERVER_MISCONFIG。
JWT_SECRET=

# ── ② 联网检索（可选） ────────────────────────────────────────
# 仅当平台 context.tools 提供 web_search 且需要联网检索时才需配置：
#   腾讯云 WSAPI 控制台 https://console.cloud.tencent.com/wsapi/index 创建
# 未配置不影响 Copilot 主流程（工具不会被下发给模型）。
WSA_API_KEY=

# ── 前端（可选覆盖） ──────────────────────────────────────────
# 同域部署留空即 /api；拆为独立后端时改为 https://<api-host>/api
NEXT_PUBLIC_API_BASE=/api
