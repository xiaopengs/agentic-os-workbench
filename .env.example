# ─────────────────────────────────────────────────────────────
# Agentic OS Workbench · 部署单元环境变量声明
#
# ⚠️ 本文件必须提交入库：EdgeOne Makers CLI 依据本文件的声明决定
#    部署时自动注入哪些变量。缺少声明 = 线上拿不到值 = 运行时报错。
#
# 变量分类：
#   ① 平台自动注入（无需手工设置，只要在此声明即可）
#   ② 业务变量（必须手工 `edgeone makers env set <KEY> <VALUE>`）
# ─────────────────────────────────────────────────────────────

# ── ① AI Gateway（平台自动注入，本地开发可留空） ──────────────
# AI Copilot 服务端经 AI Gateway 调用大模型：
#   backend/functions/copilot.ts → POST /api/ai/copilot（SSE）
#   agents/copilot/index.ts      → POST /copilot（平台 Agent 运行时）
# 凭据只存在于服务端，前端不直连大模型。
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=
# 可选：覆盖默认模型（缺省 @makers/deepseek-v4-flash）
AI_GATEWAY_MODEL=

# ── ② 鉴权（必须手工设置，≥32 位随机串） ─────────────────────
# 未注入时：生产环境所有鉴权接口返回 500 SERVER_MISCONFIG。
JWT_SECRET=

# ── ② 联网检索（可选） ────────────────────────────────────────
# 仅当平台 context.tools 提供 web_search 且需要联网检索时才需配置：
#   腾讯云 WSAPI 控制台 https://console.cloud.tencent.com/wsapi/index 创建
# 未配置不影响 Copilot 主流程（工具不会被下发给模型）。
WSA_API_KEY=

# ── 前端（可选覆盖） ──────────────────────────────────────────
# 同域部署留空即 /api；拆为独立后端时改为 https://<api-host>/api
NEXT_PUBLIC_API_BASE=/api
